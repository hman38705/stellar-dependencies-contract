// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24;

/// @title ExampleContract
/// @notice Reference contract demonstrating required NatSpec coverage for all
///         public interface elements (functions, events, and errors).
/// @dev This file documents the NatSpec requirement from issue #4. Every
///      public/external function, event, and error must carry `@notice`,
///      `@param`, and `@return` tags where applicable so that `forge doc`
///      builds a complete interface reference.
contract ExampleContract {
    /// @notice Emitted when the stored value is updated.
    /// @param previousValue The value held before the update.
    /// @param newValue The value stored after the update.
    /// @param caller The address that triggered the update.
    event ValueUpdated(uint256 indexed previousValue, uint256 indexed newValue, address indexed caller);

    /// @notice Emitted when ownership of the contract is transferred.
    /// @param previousOwner The address of the prior owner.
    /// @param newOwner The address of the newly assigned owner.
    event OwnershipTransferred(address indexed previousOwner, address indexed newOwner);

    /// @notice Thrown when a caller is not authorized to perform an action.
    /// @param caller The unauthorized caller address.
    /// @param requiredOwner The address that was required to authorize the call.
    error Unauthorized(address caller, address requiredOwner);

    /// @notice Thrown when an operation is attempted with a zero address.
    error ZeroAddress();

    /// @notice Thrown when a value fails a required constraint.
    /// @param value The offending value.
    /// @param reason A human-readable description of the constraint.
    error InvalidValue(uint256 value, string reason);

    /// @notice The current owner of the contract.
    address public owner;

    /// @notice The currently stored value.
    uint256 public value;

    /// @notice Restricts a function to the contract owner.
    /// @dev Reverts with {Unauthorized} if the caller is not the owner.
    modifier onlyOwner() {
        if (msg.sender != owner) {
            revert Unauthorized(msg.sender, owner);
        }
        _;
    }

    /// @notice Deploys the contract and sets the initial owner and value.
    /// @param initialOwner The address that will own the contract; must not be zero.
    /// @param initialValue The initial value to store.
    constructor(address initialOwner, uint256 initialValue) {
        if (initialOwner == address(0)) {
            revert ZeroAddress();
        }
        owner = initialOwner;
        value = initialValue;
        emit OwnershipTransferred(address(0), initialOwner);
        emit ValueUpdated(0, initialValue, initialOwner);
    }

    /// @notice Updates the stored value.
    /// @dev Only callable by the owner. Reverts with {InvalidValue} if `newValue` is zero.
    /// @param newValue The new value to store; must be non-zero.
    function setValue(uint256 newValue) external onlyOwner {
        if (newValue == 0) {
            revert InvalidValue(newValue, "value must be non-zero");
        }
        uint256 previousValue = value;
        value = newValue;
        emit ValueUpdated(previousValue, newValue, msg.sender);
    }

    /// @notice Returns the currently stored value.
    /// @return currentValue The value currently held by the contract.
    function getValue() external view returns (uint256 currentValue) {
        return value;
    }

    /// @notice Transfers ownership of the contract to a new address.
    /// @dev Only callable by the owner. Reverts with {ZeroAddress} if `newOwner` is zero.
    /// @param newOwner The address of the new owner; must not be zero.
    function transferOwnership(address newOwner) external onlyOwner {
        if (newOwner == address(0)) {
            revert ZeroAddress();
        }
        address previousOwner = owner;
        owner = newOwner;
        emit OwnershipTransferred(previousOwner, newOwner);
    }
}